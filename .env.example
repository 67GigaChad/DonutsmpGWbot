# The only required secret.
DISCORD_TOKEN=
# Optional
# DONUT_EMOJI=<:donut:123456789012345678>
# ROULETTE_SPEED=1
# DEV_GUILD_ID=   (instant command updates in one server while developing)
# PORT=3000       (health server; Render sets this automatically)
# KEEPALIVE_URL=https://your-service.onrender.com   (self-ping; Render sets RENDER_EXTERNAL_URL automatically)
# DATA_DIR=data   (where db.json lives; set /var/data when using a Render disk)
